FUNCTION_BLOCK weaning_mamdani

VAR_INPUT
  NIF : REAL;
  RR : REAL;
  VT : REAL;
  RSBI : REAL;
END_VAR

VAR_OUTPUT
  Resultado : REAL;
END_VAR

FUZZIFY NIF
  RANGE := (-60 .. 0);
  TERM Fraco := Trapezoid -25 -15 0 0;
  TERM Limitrofe := Triangle -35 -25 -15;
  TERM Forte := Trapezoid -60 -60 -35 -25;
END_FUZZIFY

FUZZIFY RR
  RANGE := (5 .. 60);
  TERM Adequada := Trapezoid 5 5 22 30;
  TERM Limitrofe := Triangle 22 30 38;
  TERM Elevada := Trapezoid 30 38 60 60;
END_FUZZIFY

FUZZIFY VT
  RANGE := (100 .. 1000);
  TERM Baixo := Trapezoid 100 100 300 400;
  TERM Adequado := Triangle 300 475 650;
  TERM Elevado := Trapezoid 600 750 1000 1000;
END_FUZZIFY

FUZZIFY RSBI
  RANGE := (0 .. 300);
  TERM Favoravel := Trapezoid 0 0 90 120;
  TERM Limitrofe := Triangle 90 120 150;
  TERM Desfavoravel := Trapezoid 120 150 300 300;
END_FUZZIFY

DEFUZZIFY Resultado
  RANGE := (0 .. 100);
  TERM Fracasso := Trapezoid 0 0 35 65;
  TERM Sucesso := Trapezoid 35 65 100 100;
  METHOD : COG;
  ACCU : MAX;
  DEFAULT := 0;
END_DEFUZZIFY

RULEBLOCK regras
  AND : MIN;
  ACT : MIN;
  RULE 1 : if NIF is Forte and RR is Adequada and RSBI is Favoravel then Resultado is Sucesso;
  RULE 2 : if NIF is Forte and RR is Limitrofe and RSBI is Favoravel then Resultado is Sucesso;
  RULE 3 : if NIF is Forte and RR is Adequada and RSBI is Limitrofe then Resultado is Sucesso;
  RULE 4 : if NIF is Limitrofe and RR is Adequada and VT is Adequado and RSBI is Favoravel then Resultado is Sucesso;
  RULE 5 : if NIF is Fraco then Resultado is Fracasso;
  RULE 6 : if RR is Elevada then Resultado is Fracasso;
  RULE 7 : if RSBI is Desfavoravel then Resultado is Fracasso;
  RULE 8 : if NIF is Limitrofe and VT is Baixo then Resultado is Fracasso;
  RULE 9 : if NIF is Limitrofe and VT is Elevado then Resultado is Fracasso;
  RULE 10 : if NIF is Limitrofe and RR is Limitrofe then Resultado is Fracasso;
  RULE 11 : if NIF is Limitrofe and RSBI is Limitrofe then Resultado is Fracasso;
  RULE 12 : if RR is Limitrofe and RSBI is Limitrofe then Resultado is Fracasso;
END_RULEBLOCK

END_FUNCTION_BLOCK
