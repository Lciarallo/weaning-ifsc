FUNCTION_BLOCK weaning_mamdani

VAR_INPUT
  NIF : REAL;
  RR : REAL;
  VT : REAL;
  RSBI : REAL;
END_VAR

VAR_OUTPUT
  Potencial : REAL;
END_VAR

FUZZIFY NIF
  RANGE := (-60 .. 0);
  TERM Fraco := Trapezoid -25 -15 0 0;
  TERM Limitrofe := Triangle -35 -25 -15;
  TERM Forte := Trapezoid -60 -60 -35 -25;
END_FUZZIFY

FUZZIFY RR
  RANGE := (5 .. 60);
  TERM Adequada := Trapezoid 5 5 22 30;
  TERM Limitrofe := Triangle 22 30 38;
  TERM Elevada := Trapezoid 30 38 60 60;
END_FUZZIFY

FUZZIFY VT
  RANGE := (100 .. 1000);
  TERM Baixo := Trapezoid 100 100 300 400;
  TERM Adequado := Triangle 300 475 650;
  TERM Elevado := Trapezoid 600 750 1000 1000;
END_FUZZIFY

FUZZIFY RSBI
  RANGE := (0 .. 300);
  TERM Favoravel := Trapezoid 0 0 90 120;
  TERM Limitrofe := Triangle 90 120 150;
  TERM Desfavoravel := Trapezoid 120 150 300 300;
END_FUZZIFY

DEFUZZIFY Potencial
  RANGE := (0 .. 100);
  TERM Muito_Baixo := Trapezoid 0 0 15 30;
  TERM Baixo := Triangle 15 30 45;
  TERM Moderado := Triangle 35 50 65;
  TERM Alto := Triangle 55 70 85;
  TERM Muito_Alto := Trapezoid 70 85 100 100;
  METHOD : COG;
  ACCU : MAX;
  DEFAULT := 0;
END_DEFUZZIFY

RULEBLOCK regras
  AND : MIN;
  ACT : MIN;
  RULE 1 : if NIF is Fraco and RR is Adequada and VT is Baixo and RSBI is Favoravel then Potencial is Baixo;
  RULE 2 : if NIF is Fraco and RR is Adequada and VT is Baixo and RSBI is Limitrofe then Potencial is Baixo;
  RULE 3 : if NIF is Fraco and RR is Adequada and VT is Baixo and RSBI is Desfavoravel then Potencial is Muito_Baixo;
  RULE 4 : if NIF is Fraco and RR is Adequada and VT is Adequado and RSBI is Favoravel then Potencial is Moderado;
  RULE 5 : if NIF is Fraco and RR is Adequada and VT is Adequado and RSBI is Limitrofe then Potencial is Baixo;
  RULE 6 : if NIF is Fraco and RR is Adequada and VT is Adequado and RSBI is Desfavoravel then Potencial is Baixo;
  RULE 7 : if NIF is Fraco and RR is Adequada and VT is Elevado and RSBI is Favoravel then Potencial is Moderado;
  RULE 8 : if NIF is Fraco and RR is Adequada and VT is Elevado and RSBI is Limitrofe then Potencial is Baixo;
  RULE 9 : if NIF is Fraco and RR is Adequada and VT is Elevado and RSBI is Desfavoravel then Potencial is Baixo;
  RULE 10 : if NIF is Fraco and RR is Limitrofe and VT is Baixo and RSBI is Favoravel then Potencial is Baixo;
  RULE 11 : if NIF is Fraco and RR is Limitrofe and VT is Baixo and RSBI is Limitrofe then Potencial is Muito_Baixo;
  RULE 12 : if NIF is Fraco and RR is Limitrofe and VT is Baixo and RSBI is Desfavoravel then Potencial is Muito_Baixo;
  RULE 13 : if NIF is Fraco and RR is Limitrofe and VT is Adequado and RSBI is Favoravel then Potencial is Baixo;
  RULE 14 : if NIF is Fraco and RR is Limitrofe and VT is Adequado and RSBI is Limitrofe then Potencial is Baixo;
  RULE 15 : if NIF is Fraco and RR is Limitrofe and VT is Adequado and RSBI is Desfavoravel then Potencial is Muito_Baixo;
  RULE 16 : if NIF is Fraco and RR is Limitrofe and VT is Elevado and RSBI is Favoravel then Potencial is Baixo;
  RULE 17 : if NIF is Fraco and RR is Limitrofe and VT is Elevado and RSBI is Limitrofe then Potencial is Baixo;
  RULE 18 : if NIF is Fraco and RR is Limitrofe and VT is Elevado and RSBI is Desfavoravel then Potencial is Muito_Baixo;
  RULE 19 : if NIF is Fraco and RR is Elevada and VT is Baixo and RSBI is Favoravel then Potencial is Muito_Baixo;
  RULE 20 : if NIF is Fraco and RR is Elevada and VT is Baixo and RSBI is Limitrofe then Potencial is Muito_Baixo;
  RULE 21 : if NIF is Fraco and RR is Elevada and VT is Baixo and RSBI is Desfavoravel then Potencial is Muito_Baixo;
  RULE 22 : if NIF is Fraco and RR is Elevada and VT is Adequado and RSBI is Favoravel then Potencial is Baixo;
  RULE 23 : if NIF is Fraco and RR is Elevada and VT is Adequado and RSBI is Limitrofe then Potencial is Muito_Baixo;
  RULE 24 : if NIF is Fraco and RR is Elevada and VT is Adequado and RSBI is Desfavoravel then Potencial is Muito_Baixo;
  RULE 25 : if NIF is Fraco and RR is Elevada and VT is Elevado and RSBI is Favoravel then Potencial is Baixo;
  RULE 26 : if NIF is Fraco and RR is Elevada and VT is Elevado and RSBI is Limitrofe then Potencial is Muito_Baixo;
  RULE 27 : if NIF is Fraco and RR is Elevada and VT is Elevado and RSBI is Desfavoravel then Potencial is Muito_Baixo;
  RULE 28 : if NIF is Limitrofe and RR is Adequada and VT is Baixo and RSBI is Favoravel then Potencial is Moderado;
  RULE 29 : if NIF is Limitrofe and RR is Adequada and VT is Baixo and RSBI is Limitrofe then Potencial is Baixo;
  RULE 30 : if NIF is Limitrofe and RR is Adequada and VT is Baixo and RSBI is Desfavoravel then Potencial is Baixo;
  RULE 31 : if NIF is Limitrofe and RR is Adequada and VT is Adequado and RSBI is Favoravel then Potencial is Alto;
  RULE 32 : if NIF is Limitrofe and RR is Adequada and VT is Adequado and RSBI is Limitrofe then Potencial is Moderado;
  RULE 33 : if NIF is Limitrofe and RR is Adequada and VT is Adequado and RSBI is Desfavoravel then Potencial is Baixo;
  RULE 34 : if NIF is Limitrofe and RR is Adequada and VT is Elevado and RSBI is Favoravel then Potencial is Alto;
  RULE 35 : if NIF is Limitrofe and RR is Adequada and VT is Elevado and RSBI is Limitrofe then Potencial is Moderado;
  RULE 36 : if NIF is Limitrofe and RR is Adequada and VT is Elevado and RSBI is Desfavoravel then Potencial is Baixo;
  RULE 37 : if NIF is Limitrofe and RR is Limitrofe and VT is Baixo and RSBI is Favoravel then Potencial is Baixo;
  RULE 38 : if NIF is Limitrofe and RR is Limitrofe and VT is Baixo and RSBI is Limitrofe then Potencial is Baixo;
  RULE 39 : if NIF is Limitrofe and RR is Limitrofe and VT is Baixo and RSBI is Desfavoravel then Potencial is Muito_Baixo;
  RULE 40 : if NIF is Limitrofe and RR is Limitrofe and VT is Adequado and RSBI is Favoravel then Potencial is Moderado;
  RULE 41 : if NIF is Limitrofe and RR is Limitrofe and VT is Adequado and RSBI is Limitrofe then Potencial is Baixo;
  RULE 42 : if NIF is Limitrofe and RR is Limitrofe and VT is Adequado and RSBI is Desfavoravel then Potencial is Baixo;
  RULE 43 : if NIF is Limitrofe and RR is Limitrofe and VT is Elevado and RSBI is Favoravel then Potencial is Moderado;
  RULE 44 : if NIF is Limitrofe and RR is Limitrofe and VT is Elevado and RSBI is Limitrofe then Potencial is Baixo;
  RULE 45 : if NIF is Limitrofe and RR is Limitrofe and VT is Elevado and RSBI is Desfavoravel then Potencial is Baixo;
  RULE 46 : if NIF is Limitrofe and RR is Elevada and VT is Baixo and RSBI is Favoravel then Potencial is Baixo;
  RULE 47 : if NIF is Limitrofe and RR is Elevada and VT is Baixo and RSBI is Limitrofe then Potencial is Muito_Baixo;
  RULE 48 : if NIF is Limitrofe and RR is Elevada and VT is Baixo and RSBI is Desfavoravel then Potencial is Muito_Baixo;
  RULE 49 : if NIF is Limitrofe and RR is Elevada and VT is Adequado and RSBI is Favoravel then Potencial is Baixo;
  RULE 50 : if NIF is Limitrofe and RR is Elevada and VT is Adequado and RSBI is Limitrofe then Potencial is Baixo;
  RULE 51 : if NIF is Limitrofe and RR is Elevada and VT is Adequado and RSBI is Desfavoravel then Potencial is Muito_Baixo;
  RULE 52 : if NIF is Limitrofe and RR is Elevada and VT is Elevado and RSBI is Favoravel then Potencial is Baixo;
  RULE 53 : if NIF is Limitrofe and RR is Elevada and VT is Elevado and RSBI is Limitrofe then Potencial is Baixo;
  RULE 54 : if NIF is Limitrofe and RR is Elevada and VT is Elevado and RSBI is Desfavoravel then Potencial is Muito_Baixo;
  RULE 55 : if NIF is Forte and RR is Adequada and VT is Baixo and RSBI is Favoravel then Potencial is Alto;
  RULE 56 : if NIF is Forte and RR is Adequada and VT is Baixo and RSBI is Limitrofe then Potencial is Moderado;
  RULE 57 : if NIF is Forte and RR is Adequada and VT is Baixo and RSBI is Desfavoravel then Potencial is Baixo;
  RULE 58 : if NIF is Forte and RR is Adequada and VT is Adequado and RSBI is Favoravel then Potencial is Muito_Alto;
  RULE 59 : if NIF is Forte and RR is Adequada and VT is Adequado and RSBI is Limitrofe then Potencial is Alto;
  RULE 60 : if NIF is Forte and RR is Adequada and VT is Adequado and RSBI is Desfavoravel then Potencial is Moderado;
  RULE 61 : if NIF is Forte and RR is Adequada and VT is Elevado and RSBI is Favoravel then Potencial is Muito_Alto;
  RULE 62 : if NIF is Forte and RR is Adequada and VT is Elevado and RSBI is Limitrofe then Potencial is Alto;
  RULE 63 : if NIF is Forte and RR is Adequada and VT is Elevado and RSBI is Desfavoravel then Potencial is Moderado;
  RULE 64 : if NIF is Forte and RR is Limitrofe and VT is Baixo and RSBI is Favoravel then Potencial is Moderado;
  RULE 65 : if NIF is Forte and RR is Limitrofe and VT is Baixo and RSBI is Limitrofe then Potencial is Baixo;
  RULE 66 : if NIF is Forte and RR is Limitrofe and VT is Baixo and RSBI is Desfavoravel then Potencial is Baixo;
  RULE 67 : if NIF is Forte and RR is Limitrofe and VT is Adequado and RSBI is Favoravel then Potencial is Alto;
  RULE 68 : if NIF is Forte and RR is Limitrofe and VT is Adequado and RSBI is Limitrofe then Potencial is Moderado;
  RULE 69 : if NIF is Forte and RR is Limitrofe and VT is Adequado and RSBI is Desfavoravel then Potencial is Baixo;
  RULE 70 : if NIF is Forte and RR is Limitrofe and VT is Elevado and RSBI is Favoravel then Potencial is Alto;
  RULE 71 : if NIF is Forte and RR is Limitrofe and VT is Elevado and RSBI is Limitrofe then Potencial is Moderado;
  RULE 72 : if NIF is Forte and RR is Limitrofe and VT is Elevado and RSBI is Desfavoravel then Potencial is Baixo;
  RULE 73 : if NIF is Forte and RR is Elevada and VT is Baixo and RSBI is Favoravel then Potencial is Baixo;
  RULE 74 : if NIF is Forte and RR is Elevada and VT is Baixo and RSBI is Limitrofe then Potencial is Baixo;
  RULE 75 : if NIF is Forte and RR is Elevada and VT is Baixo and RSBI is Desfavoravel then Potencial is Muito_Baixo;
  RULE 76 : if NIF is Forte and RR is Elevada and VT is Adequado and RSBI is Favoravel then Potencial is Moderado;
  RULE 77 : if NIF is Forte and RR is Elevada and VT is Adequado and RSBI is Limitrofe then Potencial is Baixo;
  RULE 78 : if NIF is Forte and RR is Elevada and VT is Adequado and RSBI is Desfavoravel then Potencial is Baixo;
  RULE 79 : if NIF is Forte and RR is Elevada and VT is Elevado and RSBI is Favoravel then Potencial is Moderado;
  RULE 80 : if NIF is Forte and RR is Elevada and VT is Elevado and RSBI is Limitrofe then Potencial is Baixo;
  RULE 81 : if NIF is Forte and RR is Elevada and VT is Elevado and RSBI is Desfavoravel then Potencial is Baixo;
END_RULEBLOCK

END_FUNCTION_BLOCK
